# Copy to .env.local. Never commit real tokens or passwords
REMOTE_API_TOKEN=
REMOTE_API_BASE_URL=https://gateway.remote-sandbox.com

# Write-scoped token for profile PATCH (department / manager) + webhook subscribe.
# Prefer Full Access / employment:write. Keep separate from read-only REMOTE_API_TOKEN.
# REMOTE_API_WRITE_TOKEN=
# (Alias still accepted:) REMOTE_WEBHOOK_ADMIN_TOKEN=

# App demo login (separate from REMOTE_API_TOKEN. Never put the Remote token in the browser)
# Set real values in .env.local / Wrangler secrets only. Do not commit credentials
# DEMO_APP_EMAIL=
# DEMO_APP_PASSWORD=
# APP_SESSION_SECRET=

# Remote OAuth scaffold (default off). Assessment uses Option B Connect wizard + REMOTE_API_TOKEN.
# REMOTE_OAUTH_ENABLED=true
# REMOTE_OAUTH_CLIENT_ID=
# REMOTE_OAUTH_AUTHORIZE_URL=

# Optional. Only after you subscribe a Remote webhook callback (shown once)
# Store the same value as a Wrangler secret: REMOTE_WEBHOOK_SIGNING_KEY
REMOTE_WEBHOOK_SIGNING_KEY=

# One-shot subscribe only (GH#44). Needs webhook:write / company_admin / all:write.
# Prefer REMOTE_API_WRITE_TOKEN above; this alias still works for ./scripts/subscribe-remote-webhook.sh
# REMOTE_WEBHOOK_ADMIN_TOKEN=
# Optional public site URL for Open Graph / Twitter share cards (defaults to Workers.dev)
# NEXT_PUBLIC_SITE_URL=https://remote-org-chart.shirechiko.workers.dev
