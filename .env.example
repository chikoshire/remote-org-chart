# Copy to .env.local — never commit real tokens
REMOTE_API_TOKEN=
REMOTE_API_BASE_URL=https://gateway.remote-sandbox.com

# App demo login (separate from REMOTE_API_TOKEN — never put the Remote token in the browser)
# Defaults: demo@acme.example / <scrubbed-old-demo-password>
# DEMO_APP_EMAIL=demo@acme.example
# DEMO_APP_PASSWORD=<scrubbed-old-demo-password>
# APP_SESSION_SECRET=replace-me-in-production

# Optional — only after you subscribe a Remote webhook callback (shown once)
# Store the same value as a Wrangler secret: REMOTE_WEBHOOK_SIGNING_KEY
REMOTE_WEBHOOK_SIGNING_KEY=

# One-shot subscribe only (GH#44). Needs webhook:write / company_admin / all:write.
# Keep REMOTE_API_TOKEN read-only for the app; use a separate short-lived write token here.
# REMOTE_WEBHOOK_ADMIN_TOKEN=
# Then: ./scripts/subscribe-remote-webhook.sh
