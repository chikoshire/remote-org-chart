{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remote-org-chart",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "REMOTE_API_BASE_URL": "https://gateway.remote-sandbox.com"
  },
  // Dedicated enrich Worker: each batch gets its own Free-plan connection pool.
  // Same-Worker self-fetch is blocked (1042); WORKER_SELF kept as fallback only.
  "services": [
    {
      "binding": "ORG_ENRICH",
      "service": "remote-org-chart-enrich"
    },
    {
      "binding": "WORKER_SELF",
      "service": "remote-org-chart"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ORG_CHART_CACHE",
      "id": "58bdbc1d85944a6fa304010c1803597c"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "SYNC_RUNS_DB",
      "database_name": "remote-org-chart-sync",
      "database_id": "530501ab-4bc3-4132-9af7-7a94508bd291",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
