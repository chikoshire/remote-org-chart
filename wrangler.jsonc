{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remote-org-chart",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "REMOTE_API_BASE_URL": "https://gateway.remote-sandbox.com"
  },
  // Self binding: fan-out enrich batches get a fresh 50-subrequest budget each
  // (Workers Free). Same-Worker public URL fetch is unreliable with OpenNext assets.
  "services": [
    {
      "binding": "WORKER_SELF",
      "service": "remote-org-chart"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ORG_CHART_CACHE",
      "id": "58bdbc1d85944a6fa304010c1803597c"
    }
  ],
  "d1_databases": [
    {
      "binding": "SYNC_RUNS_DB",
      "database_name": "remote-org-chart-sync",
      "database_id": "530501ab-4bc3-4132-9af7-7a94508bd291",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
